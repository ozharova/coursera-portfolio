name: Build and deploy to GitHub Pages (resilient)

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    outputs:
      publish_dir: ${{ steps.set-publish-dir.outputs.dir }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 18

      - name: Install dependencies
        run: npm ci

      - name: Build site
        run: npm run build

      - name: Determine publish dir
        id: set-publish-dir
        run: |
          if [ -d "./build" ]; then echo "dir=build" >> $GITHUB_OUTPUT
          elif [ -d "./dist" ]; then echo "dir=dist" >> $GITHUB_OUTPUT
          elif [ -d "./public" ]; then echo "dir=public" >> $GITHUB_OUTPUT
          else echo "dir=." >> $GITHUB_OUTPUT

      - name: Upload site artifact
        uses: actions/upload-artifact@v4
        with:
          name: site
          path: ${{ steps.set-publish-dir.outputs.dir }}

  deploy:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Download site artifact
        uses: actions/download-artifact@v4
        with:
          name: site
          path: ./site

      - name: Deploy to GitHub Pages (push to gh-pages branch)
        uses: peaceiris/actions-gh-pages@v3
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./site/${{ needs.build.outputs.publish_dir }}
          publish_branch: gh-pages
